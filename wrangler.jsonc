{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "verity-works-site",
  "main": "src/index.js",
  "compatibility_date": "2026-07-07",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "ANALYTICS_DB",
      "database_name": "verity_analytics",
      "database_id": "a90e9c19-94af-4c65-8c78-fa3cec1fd6af"
    }
  ]
}
